---
import { tagUrl } from '../lib/posts';

interface Props {
  tags: { tag: string; count: number }[];
  current?: string;
}

const { tags, current } = Astro.props;
const ordered = [...tags].sort((a, b) => {
  if (a.tag === current) return -1;
  if (b.tag === current) return 1;
  return 0;
});
---

<nav class="tag-rail" aria-label="タグ">
  <a href="/" aria-current={current ? undefined : 'page'}>すべて</a>
  {
    ordered.map(({ tag }) => (
      <a href={tagUrl(tag)} aria-current={tag === current ? 'page' : undefined}>
        {tag}
      </a>
    ))
  }
</nav>
